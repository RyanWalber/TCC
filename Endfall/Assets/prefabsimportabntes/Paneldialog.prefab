--- !u!114 &3730900162483469964
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8897663045103876425}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b6be2fa407e442a8ad12990f246145f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PainelDialogo
  painel: {fileID: 8897663045103876425}
  imagemRetrato: {fileID: 568612798597976576}
  textoNome: {fileID: 3622470750101296381}
  textoFala: {fileID: 2467181757022278878}
  indicadorContinuar: {fileID: 0}
  falasPadrao:
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "Ora, ora... Ent\xE3o voc\xEA \xE9 a famosa ca\xE7adora. Vejo que encontrou
      minha carta!"
  - personagem: Kaya
    retrato: {fileID: -9099357462280670973, guid: 644b300e7a1d1ad4495b2338fdae373c, type: 3}
    texto: "Voc\xEA escreveu aquilo? Quem \xE9 voc\xEA?"
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "Cael, minha querida. Uma antiga conhecedora destes dom\xEDnios."
  - personagem: Kaya
    retrato: {fileID: -9099357462280670973, guid: 644b300e7a1d1ad4495b2338fdae373c, type: 3}
    texto: "E por que est\xE1 me ajudando?"
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "T\xE9dio! Faz s\xE9culos que n\xE3o acontece nada interessante por aqui."
  - personagem: Kaya
    retrato: {fileID: -9099357462280670973, guid: 644b300e7a1d1ad4495b2338fdae373c, type: 3}
    texto: "Minha fam\xEDlia foi massacrada pela Morte. Isso n\xE3o \xE9 uma brincadeira!"
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "Para voc\xEA, n\xE3o. Para mim, \xE9 uma hist\xF3ria bastante promissora."
  - personagem: Kaya
    retrato: {fileID: -9099357462280670973, guid: 644b300e7a1d1ad4495b2338fdae373c, type: 3}
    texto: "S\xF3 quero chegar at\xE9 a Morte."
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "Ent\xE3o continue viva. Deixarei outras cartas pelo caminho. Talvez sejam
      \xFAteis."
  - personagem: Kaya
    retrato: {fileID: -9099357462280670973, guid: 644b300e7a1d1ad4495b2338fdae373c, type: 3}
    texto: "N\xE3o confio em voc\xEA."
  - personagem: Cael
    retrato: {fileID: -2977574420608923027, guid: 7e98c0910539eac4e9dae28349c56b41, type: 3}
    texto: "Parab\xE9n, entrou para a fila! At\xE9 mais, querida."
  iniciarAutomaticamente: 0
  bloquearControlesDaKaya: 1
  segundosPorCaractere: 0.035
  aoTerminarDialogo:
    m_PersistentCalls:
      m_Calls: []
